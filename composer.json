{
    "name": "kolovious/meli-socialite",
    "description": "Mercadolibre Laravel Socialite Integration",
    "keywords": [
        "Laravel",
        "Socialite",
        "Mercadolibre"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Leonardo Garcia",
            "email": "cololeo@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "mercadolibre/php-sdk",
                "version": "master",
                "source": {
                    "url": "https://github.com/mercadolibre/php-sdk.git",
                    "type": "git",
                    "reference": "master"
                }
            }
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "laravel/socialite": "^5.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "mercadolibre/php-sdk": "master"
    },
    "autoload": {
        "psr-4": {
            "Kolovious\\MeliSocialite\\": "src/"
        },
        "files": [
            "vendor/mercadolibre/php-sdk/Meli/meli.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kolovious\\MeliSocialite\\MeliSocialiteServiceProvider"
            ],
            "aliases": {
                "Meli": "Kolovious\\MeliSocialite\\Facade\\Meli"
            }
        }
    }
}
